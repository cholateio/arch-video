{
  "name": "arch-video",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a repo into a narrated architecture explainer video, in a living-blueprint style.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/arch-video.mjs build examples/demo/storyboard.json",
    "stills": "node scripts/arch-video.mjs build examples/demo/storyboard.json --stills-only"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-tc": "5.3.1",
    "@phosphor-icons/core": "2.1.1",
    "cheerio": "1.2.0",
    "gsap": "3.15.1",
    "hyperframes": "0.9.67",
    "node-edge-tts": "1.2.12"
  }
}
